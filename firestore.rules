rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return verifiedEmail()
        && request.auth.token.email in ["lyyuan03@gmail.com"];
    }

    function wellnessMember() {
      return get(/databases/$(database)/documents/memberAccess/$(request.auth.token.email));
    }

    function sponsorMember() {
      return get(/databases/$(database)/documents/sponsorMemberAccess/$(request.auth.token.email));
    }

    function memberEntitlement() {
      return get(/databases/$(database)/documents/memberEntitlements/$(request.auth.token.email));
    }

    function hasWellnessMemberRecord() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/memberAccess/$(request.auth.token.email));
    }

    function hasSponsorMemberRecord() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/sponsorMemberAccess/$(request.auth.token.email));
    }

    function hasMemberEntitlementRecord() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/memberEntitlements/$(request.auth.token.email));
    }

    function hasEventPermission(permission) {
      let email = request.auth.token.email.lower();
      let path = /databases/$(database)/documents/memberEntitlements/$(email);
      return verifiedEmail()
        && email.matches('^[^@]+@gmail[.]com$')
        && exists(path)
        && get(path).data.email == email
        && get(path).data.keys().hasAny(["permissions"])
        && get(path).data.permissions is list
        && get(path).data.permissions.hasAny([permission])
        && (!get(path).data.keys().hasAny(["disabled"]) || get(path).data.disabled != true)
        && (!get(path).data.keys().hasAny(["suspended"]) || get(path).data.suspended != true)
        && (!get(path).data.keys().hasAny(["status"]) || get(path).data.status != "disabled");
    }

    function safePublicEventArticle() {
      return !request.resource.data.keys().hasAny(["requiredPermission"])
        || (request.resource.data.accessType == "event"
          && request.resource.data.content == ""
          && (!request.resource.data.keys().hasAny(["previousContentBackup"])
            || request.resource.data.previousContentBackup == "")
          && (!request.resource.data.keys().hasAny(["encryptedContent"])
            || request.resource.data.encryptedContent == "")
          && (!request.resource.data.keys().hasAny(["magicLinkAccess"])
            || request.resource.data.magicLinkAccess.size() == 0));
    }

    function hasValidWellnessExpiry() {
      return wellnessMember().data.keys().hasAny(["expiresAt"])
        && wellnessMember().data.expiresAt is timestamp
        && wellnessMember().data.expiresAt > request.time;
    }

    function isActiveWellnessMember() {
      return hasWellnessMemberRecord()
        && wellnessMember().data.status == "active"
        && wellnessMember().data.paymentStatus == "paid"
        && hasValidWellnessExpiry()
        && wellnessMember().data.memberType == "wellness-channel"
        && wellnessMember().data.wellnessAccess == true
        && wellnessMember().data.memberLevel in ["wellness", "lingji"]
        && (!wellnessMember().data.keys().hasAny(["disabled"])
          || wellnessMember().data.disabled != true)
        && (!wellnessMember().data.keys().hasAny(["suspended"])
          || wellnessMember().data.suspended != true)
        && (!wellnessMember().data.keys().hasAny(["revokedAt"])
          || wellnessMember().data.revokedAt == null);
    }

    function isLingjiMember() {
      return isActiveWellnessMember()
        && wellnessMember().data.memberLevel == "lingji";
    }

    function hasDirectSponsorArticleAccess() {
      return hasSponsorMemberRecord()
        && sponsorMember().data.email == request.auth.token.email
        && sponsorMember().data.memberType == "sponsor-member"
        && sponsorMember().data.status == "active"
        && sponsorMember().data.paymentStatus == "paid"
        && sponsorMember().data.articleAccess == true
        && sponsorMember().data.accessScope == "sponsor-paid-articles"
        && sponsorMember().data.accessVersion is int
        && sponsorMember().data.accessVersion >= 1
        && sponsorMember().data.keys().hasAny(["expiresAt"])
        && sponsorMember().data.expiresAt is timestamp
        && sponsorMember().data.expiresAt > request.time
        && (!sponsorMember().data.keys().hasAny(["startsAt"])
          || !(sponsorMember().data.startsAt is timestamp)
          || sponsorMember().data.startsAt <= request.time)
        && (!sponsorMember().data.keys().hasAny(["disabled"])
          || sponsorMember().data.disabled != true)
        && (!sponsorMember().data.keys().hasAny(["suspended"])
          || sponsorMember().data.suspended != true)
        && (!sponsorMember().data.keys().hasAny(["revokedAt"])
          || sponsorMember().data.revokedAt == null);
    }

    function hasWellnessPaidArticleAccess() {
      return isActiveWellnessMember()
        && (
          wellnessMember().data.memberLevel == "lingji"
          || (wellnessMember().data.keys().hasAny(["articleAccess"])
            && wellnessMember().data.articleAccess == true)
        );
    }

    function hasCanonicalPaidArticleAccess() {
      return hasMemberEntitlementRecord()
        && memberEntitlement().data.email == request.auth.token.email
        && memberEntitlement().data.schemaVersion is int
        && memberEntitlement().data.schemaVersion >= 1
        && memberEntitlement().data.status != "disabled"
        && (
          (
            memberEntitlement().data.keys().hasAny(["sponsorArticleAccess", "sponsorExpiresAt"])
            && memberEntitlement().data.sponsorArticleAccess == true
            && memberEntitlement().data.sponsorExpiresAt is timestamp
            && memberEntitlement().data.sponsorExpiresAt > request.time
          )
          || (
            memberEntitlement().data.keys().hasAny(["wellnessArticleAccess", "wellnessExpiresAt"])
            && memberEntitlement().data.wellnessArticleAccess == true
            && memberEntitlement().data.wellnessExpiresAt is timestamp
            && memberEntitlement().data.wellnessExpiresAt > request.time
          )
        );
    }

    function sponsorSourceNewerThanEntitlement() {
      return hasSponsorMemberRecord()
        && sponsorMember().data.keys().hasAny(["updatedAt"])
        && sponsorMember().data.updatedAt is timestamp
        && (
          !hasMemberEntitlementRecord()
          || !memberEntitlement().data.keys().hasAny(["computedAt"])
          || !(memberEntitlement().data.computedAt is timestamp)
          || sponsorMember().data.updatedAt > memberEntitlement().data.computedAt
        );
    }

    function wellnessSourceNewerThanEntitlement() {
      return hasWellnessMemberRecord()
        && wellnessMember().data.keys().hasAny(["updatedAt"])
        && wellnessMember().data.updatedAt is timestamp
        && (
          !hasMemberEntitlementRecord()
          || !memberEntitlement().data.keys().hasAny(["computedAt"])
          || !(memberEntitlement().data.computedAt is timestamp)
          || wellnessMember().data.updatedAt > memberEntitlement().data.computedAt
        );
    }

    function shouldUseLegacyAccessFallback() {
      return !hasMemberEntitlementRecord()
        || sponsorSourceNewerThanEntitlement()
        || wellnessSourceNewerThanEntitlement();
    }

    // 付費文章閱讀範圍（2026-10-01 起）：會員只能閱讀「本期連續會員開通日前 30 天起」發表的付費文章；
    // 資格到期或取消後一律不能閱讀。規則生效前已在期間內的舊會員本期不受限制（起算時間 1970-01-01）。
    function articleWindowEffectiveAt() {
      return timestamp.date(2026, 9, 30) + duration.value(16, 'h');
    }

    function articleWindowLookback() {
      return duration.value(30, 'd');
    }

    function paidArticlePublishedOnOrAfter(articleId, windowStart) {
      let articlePath = /databases/$(database)/documents/articles/$(articleId);
      return windowStart is timestamp
        && exists(articlePath)
        && get(articlePath).data.keys().hasAny(["publishedAt"])
        && get(articlePath).data.publishedAt is timestamp
        && get(articlePath).data.publishedAt >= windowStart;
    }

    // entitlement 尚未寫入閱讀範圍時（舊版後端剛建立），改以會員來源資料判斷閱讀範圍。
    function entitlementWindowAllows(articleId, windowField, sourceRecord) {
      return (!memberEntitlement().data.keys().hasAny(["articleWindowPolicy"])
          && memberRecordWindowAllows(sourceRecord, articleId))
        || (memberEntitlement().data.keys().hasAny(["articleWindowPolicy"])
          && memberEntitlement().data.keys().hasAny([windowField])
          && memberEntitlement().data[windowField] is timestamp
          && (memberEntitlement().data[windowField].toMillis() == 0
            || paidArticlePublishedOnOrAfter(articleId, memberEntitlement().data[windowField])));
    }

    function hasCanonicalPaidArticleAccessInWindow(articleId) {
      return hasCanonicalPaidArticleAccess()
        && (
          (
            memberEntitlement().data.keys().hasAny(["sponsorArticleAccess", "sponsorExpiresAt"])
            && memberEntitlement().data.sponsorArticleAccess == true
            && memberEntitlement().data.sponsorExpiresAt is timestamp
            && memberEntitlement().data.sponsorExpiresAt > request.time
            && entitlementWindowAllows(articleId, "sponsorArticleWindowStartsAt", sponsorMember().data)
          )
          || (
            memberEntitlement().data.keys().hasAny(["wellnessArticleAccess", "wellnessExpiresAt"])
            && memberEntitlement().data.wellnessArticleAccess == true
            && memberEntitlement().data.wellnessExpiresAt is timestamp
            && memberEntitlement().data.wellnessExpiresAt > request.time
            && entitlementWindowAllows(articleId, "wellnessArticleWindowStartsAt", wellnessMember().data)
          )
        );
    }

    function memberRecordWindowAllows(record, articleId) {
      return (record.keys().hasAny(["articleWindowStartsAt"]) && record.articleWindowStartsAt is timestamp)
        ? paidArticlePublishedOnOrAfter(articleId, record.articleWindowStartsAt - articleWindowLookback())
        : ((record.keys().hasAny(["startsAt"])
            && record.startsAt is timestamp
            && record.startsAt >= articleWindowEffectiveAt())
          ? paidArticlePublishedOnOrAfter(articleId, record.startsAt - articleWindowLookback())
          : true);
    }

    function canReadPaidArticles(articleId) {
      return isAdmin()
        || hasCanonicalPaidArticleAccessInWindow(articleId)
        || (shouldUseLegacyAccessFallback()
          && (
            (hasDirectSponsorArticleAccess() && memberRecordWindowAllows(sponsorMember().data, articleId))
            || (hasWellnessPaidArticleAccess() && memberRecordWindowAllows(wellnessMember().data, articleId))
          ));
    }

    function hasCanonicalWellnessVideoAccess() {
      return hasMemberEntitlementRecord()
        && memberEntitlement().data.email == request.auth.token.email
        && memberEntitlement().data.schemaVersion is int
        && memberEntitlement().data.schemaVersion >= 1
        && memberEntitlement().data.keys().hasAny(["wellnessVideoAccess", "wellnessExpiresAt"])
        && memberEntitlement().data.wellnessVideoAccess == true
        && memberEntitlement().data.wellnessExpiresAt is timestamp
        && memberEntitlement().data.wellnessExpiresAt > request.time;
    }

    function hasCanonicalLingjiAccess() {
      return hasCanonicalWellnessVideoAccess()
        && memberEntitlement().data.keys().hasAny(["lingjiAccess"])
        && memberEntitlement().data.lingjiAccess == true;
    }

    function canReadMemberVideo(accessLevel) {
      return isAdmin()
        || (
          hasCanonicalWellnessVideoAccess()
          && (accessLevel == "wellness"
            || (accessLevel == "lingji" && hasCanonicalLingjiAccess()))
        )
        || (
          shouldUseLegacyAccessFallback()
          && isActiveWellnessMember()
          && (accessLevel == "wellness"
            || (accessLevel == "lingji" && isLingjiMember()))
        );
    }

    match /articles/{articleId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create: if isAdmin() && safePublicEventArticle();
      allow update: if isAdmin() && safePublicEventArticle()
        && (!resource.data.keys().hasAny(["requiredPermission"])
          || request.resource.data.requiredPermission == resource.data.requiredPermission);
      allow delete: if isAdmin();
    }

    match /eventArticleBodies/{articleId} {
      allow get: if isAdmin()
        || (resource.data.status == "published"
          && resource.data.active == true
          && get(/databases/$(database)/documents/articles/$(articleId)).data.status == "published"
          && resource.data.requiredPermission is string
          && hasEventPermission(resource.data.requiredPermission));
      allow list, create, update, delete: if isAdmin();
    }

    match /paidArticleBodies/{articleId} {
      allow read: if canReadPaidArticles(articleId)
        && (isAdmin() || resource.data.status == "published")
        && resource.data.active != false;
      allow create, update, delete: if isAdmin();
    }

    match /articleMetrics/{articleId} {
      allow read: if true;

      // Increments require signed-in users (blocks anonymous metric inflation).
      // Admin may create/update non-metric docs such as the publication status index.
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly([
          "articleId", "views", "shares", "copies", "updatedAt"
        ])
        && request.resource.data.articleId == articleId
        && request.resource.data.views is int
        && request.resource.data.shares is int
        && request.resource.data.copies is int
        && request.resource.data.views >= 0
        && request.resource.data.shares >= 0
        && request.resource.data.copies >= 0
        && request.resource.data.views
          + request.resource.data.shares
          + request.resource.data.copies == 1
        && request.resource.data.updatedAt == request.time);

      allow update: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly([
          "articleId", "views", "shares", "copies", "updatedAt"
        ])
        && request.resource.data.articleId == articleId
        && request.resource.data.articleId == resource.data.articleId
        && request.resource.data.views is int
        && request.resource.data.shares is int
        && request.resource.data.copies is int
        && request.resource.data.views >= resource.data.views
        && request.resource.data.shares >= resource.data.shares
        && request.resource.data.copies >= resource.data.copies
        && request.resource.data.views - resource.data.views <= 1
        && request.resource.data.shares - resource.data.shares <= 1
        && request.resource.data.copies - resource.data.copies <= 1
        && request.resource.data.views - resource.data.views
          + request.resource.data.shares - resource.data.shares
          + request.resource.data.copies - resource.data.copies == 1
        && request.resource.data.updatedAt == request.time);

      allow delete: if isAdmin();
    }

    match /articleNotifications/{articleId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /membershipSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /memberAccess/{memberEmail} {
      allow read: if isAdmin()
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == memberEmail);
      allow create, update, delete: if isAdmin();
    }

    match /sponsorMemberAccess/{memberEmail} {
      allow read: if isAdmin()
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == memberEmail);
      allow create, update, delete: if isAdmin();
    }

    match /memberEntitlements/{memberEmail} {
      allow read: if isAdmin()
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == memberEmail);
      allow create, update, delete: if isAdmin();
    }

    match /membershipHistory/{memberEmail} {
      allow read: if isAdmin()
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == memberEmail);
      allow create, update, delete: if isAdmin();
    }

    match /memberVideos/{videoId} {
      allow read: if isAdmin()
        || (resource.data.status == "published"
          && canReadMemberVideo(resource.data.accessLevel));
      allow create, update, delete: if isAdmin();
    }

    match /membershipOrders/{orderId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
