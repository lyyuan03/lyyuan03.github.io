rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in ["lyyuan03@gmail.com"];
    }

    function wellnessMember() {
      return get(/databases/$(database)/documents/memberAccess/$(request.auth.token.email));
    }

    function isActiveWellnessMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && wellnessMember().data.email == request.auth.token.email
        && wellnessMember().data.status == "active"
        && wellnessMember().data.paymentStatus == "paid"
        && wellnessMember().data.expiresAt > request.time
        && wellnessMember().data.memberType == "wellness-channel"
        && wellnessMember().data.wellnessAccess == true
        && wellnessMember().data.memberLevel in ["wellness", "lingji"]
        && wellnessMember().data.disabled != true
        && wellnessMember().data.suspended != true
        && wellnessMember().data.revokedAt == null;
    }

    function isLingjiMember() {
      return isActiveWellnessMember()
        && (wellnessMember().data.memberLevel == "lingji"
          || wellnessMember().data.wellnessLevel in ["lingji", "wellness-premium"]
          || wellnessMember().data.annualSpend >= 100000);
    }

    match /articles/{articleId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /articleMetrics/{articleId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
          "articleId", "views", "shares", "copies", "updatedAt"
        ])
        && request.resource.data.articleId == articleId
        && request.resource.data.views is int
        && request.resource.data.shares is int
        && request.resource.data.copies is int
        && request.resource.data.views >= 0
        && request.resource.data.shares >= 0
        && request.resource.data.copies >= 0
        && request.resource.data.views
          + request.resource.data.shares
          + request.resource.data.copies == 1
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin() || (
        request.resource.data.keys().hasOnly([
          "articleId", "views", "shares", "copies", "updatedAt"
        ])
        && request.resource.data.articleId == articleId
        && request.resource.data.articleId == resource.data.articleId
        && request.resource.data.views is int
        && request.resource.data.shares is int
        && request.resource.data.copies is int
        && request.resource.data.views >= resource.data.views
        && request.resource.data.shares >= resource.data.shares
        && request.resource.data.copies >= resource.data.copies
        && request.resource.data.views - resource.data.views <= 1
        && request.resource.data.shares - resource.data.shares <= 1
        && request.resource.data.copies - resource.data.copies <= 1
        && request.resource.data.views - resource.data.views
          + request.resource.data.shares - resource.data.shares
          + request.resource.data.copies - resource.data.copies == 1
        && request.resource.data.updatedAt == request.time
      );

      allow delete: if isAdmin();
    }

    match /membershipSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /memberAccess/{memberEmail} {
      allow read: if isAdmin()
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == memberEmail
          && resource.data.email == memberEmail);
      allow create, update, delete: if isAdmin();
    }

    match /sponsorMemberAccess/{memberEmail} {
      allow read: if isAdmin()
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == memberEmail
          && resource.data.email == memberEmail);
      allow create, update, delete: if isAdmin();
    }

    match /membershipHistory/{memberEmail} {
      allow read: if isAdmin()
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email == memberEmail
          && resource.data.email == memberEmail);
      allow create, update, delete: if isAdmin();
    }

    match /memberVideos/{videoId} {
      allow read: if isAdmin() || (
        isActiveWellnessMember()
        && resource.data.status == "published"
        && (resource.data.accessLevel == "wellness"
          || (resource.data.accessLevel == "lingji" && isLingjiMember()))
      );
      allow create, update, delete: if isAdmin();
    }

    match /membershipOrders/{orderId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
